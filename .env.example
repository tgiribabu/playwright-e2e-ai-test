# Copy to .env (git-ignored). Values here are ONLY for the local demo stack (npm run demo:up).
# Secret lookup order for name X with TEST_ENV=qa, TENANT=acme:  QA_ACME_X → QA_X → X
# Per-environment files are also loaded: .env.qa, .env.stage (git-ignored), then .env.

TEST_ENV=local
# TENANT=acme
# DEVICES=chromium            # or desktop,mobile | webkit,mobile-safari | tablet
# HEALING_MODE=report         # report | strict | off
# LOG_LEVEL=info

# ---- local demo stack ----
APP_USERNAME=demo.user
APP_PASSWORD=demo-pass-123
DB_PASSWORD=localdev
SF_CLIENT_ID=demo-client-id
SF_CLIENT_SECRET=demo-client-secret

# ---- CURA public demo site (TEST_ENV=cura); these are the demo credentials printed on its login page ----
CURA_UI_USERNAME=John Doe
CURA_UI_PASSWORD=ThisIsNotAPassword

# ---- qa / stage (real values come from your vault / CI secrets, never from this file) ----
# QA_APP_USERNAME=
# QA_APP_PASSWORD=
# QA_DB_PASSWORD=
# QA_SF_CLIENT_ID=
# QA_SF_USERNAME=
# QA_SF_JWT_KEY_PATH=./.secrets/qa-server.key
# QA_GLOBEX_APP_PASSWORD=     # tenant-specific override example

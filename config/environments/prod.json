  "db": { "host": "prod-replica.internal.example.com", "port": 5432, "database": "app", "user": "qa_readonly", "passwordSecret": "DB_PASSWORD", "ssl": true, "required": false },
  "tenants": { "acme": { "displayName": "Acme Health" } }
}

  "$comment": "Production: read-only. Mutating API/DB calls are blocked at runtime and @mutating tests are excluded.",
  "name": "prod",
  "readOnly": true,
  "defaultTenant": "acme",
  "ui": { "baseUrl": "https://app.example.com" },
